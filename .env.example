# Lấy 2 connection string này từ Neon dashboard (neon.tech) sau khi tạo project:
# - DATABASE_URL: connection string dạng "pooled" (có "-pooler" trong hostname) — dùng lúc app chạy
# - DIRECT_URL: connection string "direct" (không pooled) — chỉ dùng khi chạy `prisma migrate`
#
# Ví dụ dạng: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

DATABASE_URL="postgresql://REPLACE_ME@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://REPLACE_ME@ep-example.region.aws.neon.tech/dbname?sslmode=require"
